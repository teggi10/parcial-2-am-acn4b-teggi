<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_height"
    android:background="@drawable/bg_action_bar"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navHomeIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/navHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_nav" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/navNewRecipe"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/nav_new_recipe"
        android:src="@drawable/ic_add" />

    <LinearLayout
        android:id="@+id/navShopping"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navShoppingIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shopping"
            app:tint="@color/muted" />

        <TextView
            android:id="@+id/navShoppingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_shopping"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_nav" />
    </LinearLayout>
</LinearLayout>
