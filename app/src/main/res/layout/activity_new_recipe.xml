<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".NewRecipeActivity">

    <LinearLayout
        android:id="@+id/newRecipeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:layout_width="@dimen/round_button_size"
            android:layout_height="@dimen/round_button_size"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/back"
            android:onClick="goBack"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/step_gap"
            android:text="@string/new_recipe_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/newRecipeActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/newRecipeHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <ImageView
                android:id="@+id/newRecipePhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/featured_image_height"
                android:background="@drawable/bg_thumb"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_photo_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/photoUrlInput"
                    style="@style/Fogon.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/new_recipe_photo_hint"
                    android:inputType="textUri" />

                <Button
                    style="@style/Fogon.SmallButton"
                    android:onClick="previewPhoto"
                    android:text="@string/new_recipe_photo_preview" />
            </LinearLayout>

            <TextView
                style="@style/Fogon.Label"
                android:text="@string/new_recipe_name" />

            <EditText
                android:id="@+id/nameInput"
                style="@style/Fogon.Input"
                android:layout_width="match_parent"
                android:hint="@string/new_recipe_name_hint"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/Fogon.Label"
                android:text="@string/new_recipe_description" />

            <EditText
                android:id="@+id/descriptionInput"
                style="@style/Fogon.Input"
                android:layout_width="match_parent"
                android:hint="@string/new_recipe_description_hint"
                android:inputType="textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Fogon.Label"
                        android:text="@string/new_recipe_category" />

                    <Spinner
                        android:id="@+id/categorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/search_height"
                        android:background="@drawable/bg_search"
                        android:entries="@array/new_recipe_categories"
                        android:paddingStart="@dimen/search_padding"
                        android:paddingEnd="@dimen/search_padding" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/card_gap"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Fogon.Label"
                        android:text="@string/new_recipe_minutes" />

                    <EditText
                        android:id="@+id/minutesInput"
                        style="@style/Fogon.Input"
                        android:layout_width="match_parent"
                        android:hint="@string/new_recipe_default_minutes"
                        android:inputType="number" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/card_gap"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Fogon.Label"
                        android:text="@string/new_recipe_servings" />

                    <EditText
                        android:id="@+id/servingsInput"
                        style="@style/Fogon.Input"
                        android:layout_width="match_parent"
                        android:hint="@string/new_recipe_default_servings"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/ingredientsLabel"
                style="@style/Fogon.Label"
                android:text="@string/new_recipe_ingredients" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/quantityInput"
                    style="@style/Fogon.Input"
                    android:layout_width="@dimen/quantity_input_width"
                    android:hint="@string/new_recipe_quantity_hint"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/ingredientInput"
                    style="@style/Fogon.Input"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1"
                    android:hint="@string/new_recipe_ingredient_hint"
                    android:inputType="text" />

                <Button
                    style="@style/Fogon.SmallButton"
                    android:onClick="addIngredient"
                    android:text="@string/new_recipe_add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ingredientsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/stepsLabel"
                style="@style/Fogon.Label"
                android:text="@string/new_recipe_steps" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/stepInput"
                    style="@style/Fogon.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/new_recipe_step_hint"
                    android:inputType="textCapSentences" />

                <Button
                    style="@style/Fogon.SmallButton"
                    android:onClick="addStep"
                    android:text="@string/new_recipe_add" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/newRecipeActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_bar"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/action_bar_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/action_bar_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"
            android:onClick="saveRecipe"
            android:text="@string/new_recipe_save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/tomato"
            app:cornerRadius="@dimen/card_radius" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
